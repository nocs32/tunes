# Copy to .env (git-ignored) and fill in. The server reads it from the repo root in dev.

# Server port (dev). Vite on 5180 forwards /api here.
API_PORT=2574

# SQLite file. Defaults to ./data/tunes.db.
# DATABASE_PATH=./data/tunes.db

# The address you open Tunes at. Spotify sends you back to PUBLIC_URL/api/auth/callback,
# which must be listed in the Spotify dashboard. Never "localhost".
PUBLIC_URL=http://127.0.0.1:5180

# Spotify login. From developer.spotify.com/dashboard → your app → Settings.
# Not a secret (PKCE uses no client secret), but kept out of the repo anyway.
SPOTIFY_CLIENT_ID=

# Encrypts Spotify tokens in the database. 32 random bytes, base64. Secret.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it once people have logged in (it logs everyone out).
TOKEN_KEY=

# M2 · Claude. From console.anthropic.com → API keys. Secret.
# ANTHROPIC_API_KEY=
