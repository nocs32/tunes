# Copy to .env (git-ignored) and fill in. The server reads it from the repo root in dev.

# Server port (dev). Vite on 5180 forwards /api here.
API_PORT=2574

# SQLite file. Defaults to ./data/tunes.db.
# DATABASE_PATH=./data/tunes.db

# M1 · Spotify login. From developer.spotify.com/dashboard → your app → Settings.
# Not a secret (PKCE uses no client secret), but kept out of the repo anyway.
SPOTIFY_CLIENT_ID=

# M2 · Claude. From console.anthropic.com → API keys. Secret.
# ANTHROPIC_API_KEY=
